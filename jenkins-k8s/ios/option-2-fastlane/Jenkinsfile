pipeline {
    agent { label 'ios-agent' }

    environment {
        NEXUS_CREDS                  = credentials('nexus-creds')
        JFROG_CREDS                  = credentials('jfrog-creds')
        FASTLANE_DONT_STORE_PASSWORD = '1'
        FASTLANE_SKIP_UPDATE_CHECK   = '1'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'file:///Users/dk/jenkins-agent/git/FoodTruck', branch: 'main'
            }
        }

        stage('Bundle Install') {
            steps {
                sh 'bundle config set --local path vendor/bundle && bundle install --jobs 4 --retry 3'
            }
        }

        stage('Resolve Dependencies') {
            steps {
                sh 'bundle exec fastlane resolve_deps'
            }
        }

        stage('Test') {
            steps {
                sh 'bundle exec fastlane test'
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'reports/test-results.xml'
                    publishHTML([
                        allowMissing: true, alwaysLinkToLastBuild: true, keepAll: true,
                        reportDir: 'reports', reportFiles: 'test-results.html',
                        reportName: 'Test Results'
                    ])
                }
            }
        }

        stage('Build') {
            steps {
                sh "BUILD_NUMBER=${BUILD_NUMBER} bundle exec fastlane build"
            }
            post {
                always {
                    archiveArtifacts artifacts: 'build/*.ipa', allowEmptyArchive: true
                }
            }
        }

        stage('SAST') {
            steps {
                sh 'bundle exec fastlane sast'
            }
            post {
                always {
                    publishHTML([
                        allowMissing: true, alwaysLinkToLastBuild: true, keepAll: true,
                        reportDir: 'reports', reportFiles: 'swiftlint.html',
                        reportName: 'SwiftLint'
                    ])
                }
            }
        }

        stage('Upload') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'nexus-creds',
                        usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS'),
                    usernamePassword(credentialsId: 'jfrog-creds',
                        usernameVariable: 'JFROG_USER', passwordVariable: 'JFROG_PASS')
                ]) {
                    sh 'bundle exec fastlane upload_nexus'
                    sh 'bundle exec fastlane upload_jfrog'
                }
            }
        }
    }

    post {
        failure {
            emailext(
                subject: "[iOS-Fastlane FAILURE] ${JOB_NAME} #${BUILD_NUMBER}",
                to: 'reject@hellodk.io',
                mimeType: 'text/html',
                body: '${SCRIPT, template="failure-email.groovy"}'
            )
        }
        success {
            emailext(
                subject: "[iOS-Fastlane SUCCESS] ${JOB_NAME} #${BUILD_NUMBER} — IPA ready",
                to: 'reject@hellodk.io',
                mimeType: 'text/html',
                body: '${SCRIPT, template="success-email.groovy"}'
            )
        }
        cleanup { deleteDir() }
    }
}
