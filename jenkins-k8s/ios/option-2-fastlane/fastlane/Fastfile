default_platform(:ios)

platform :ios do

  before_all do
    setup_ci if ENV['CI']
  end

  # ── Resolve Swift Package Manager dependencies ──────────────────────────────
  lane :resolve_deps do
    sh("xcodebuild -resolvePackageDependencies -project FoodTruck.xcodeproj -scheme 'Food Truck'")
  end

  # ── Unit tests ───────────────────────────────────────────────────────────────
  lane :test do
    scan(
      scheme:           'Food Truck',
      device:           'iPhone 16',
      output_directory: 'reports',
      output_types:     'junit,html',
      output_files:     'test-results.xml,test-results.html',
      fail_build:       false
    )
  end

  # ── Build IPA (unsigned for CI) ──────────────────────────────────────────────
  lane :build do
    increment_build_number(build_number: ENV['BUILD_NUMBER'] || '1')
    gym(
      scheme:           'Food Truck',
      configuration:    'Release',
      export_method:    'development',
      output_directory: 'build',
      output_name:      "FoodTruck-#{ENV['BUILD_NUMBER']}.ipa",
      xcpretty_args:    '--color',
      skip_codesigning: true
    )
  end

  # ── SAST ─────────────────────────────────────────────────────────────────────
  lane :sast do
    sh("mkdir -p reports")
    sh("swiftlint lint --reporter html > reports/swiftlint.html || true")
    sh("swiftlint lint --reporter json > reports/swiftlint.json || true")
    sh("semgrep --config=auto --json --output=reports/semgrep-ios.json " \
       "--include='*.swift' --exclude='build/' . || true")
  end

  # ── Upload to Nexus ──────────────────────────────────────────────────────────
  lane :upload_nexus do
    ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]
    name = File.basename(ipa)
    sh("curl -sf -u #{ENV['NEXUS_USER']}:#{ENV['NEXUS_PASS']} " \
       "--upload-file '#{ipa}' " \
       "'http://nexus.utilities.svc.cluster.local:8081/repository/ios-releases/#{name}' " \
       "&& echo 'Nexus: uploaded #{name}'")
  end

  # ── Upload to JFrog Artifactory ──────────────────────────────────────────────
  lane :upload_jfrog do
    ipa = lane_context[SharedValues::IPA_OUTPUT_PATH]
    name = File.basename(ipa)
    sh("curl -sf " \
       "-u #{ENV['JFROG_USER']}:#{ENV['JFROG_PASS']} " \
       "-X PUT --upload-file '#{ipa}' " \
       "'http://100.89.50.27:30082/artifactory/example-repo-local/ios/#{name}' " \
       "&& echo 'JFrog: uploaded #{name}'")
  end

  # ── Full CI lane ─────────────────────────────────────────────────────────────
  lane :ci do
    resolve_deps
    test
    build
    sast
    upload_nexus
    upload_jfrog
  end

end
