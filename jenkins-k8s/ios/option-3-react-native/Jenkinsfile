// React Native iOS pipeline
// Dependency chain: npm ci → pod install → xcodebuild
// Reference app: Mattermost Mobile (https://github.com/mattermost/mattermost-mobile)
// or any React Native app with ios/Podfile + package.json
pipeline {
    agent { label 'ios-agent' }

    environment {
        APP_NAME     = 'Mattermost'
        SCHEME       = 'Mattermost'
        // React Native projects use .xcworkspace (generated by CocoaPods), not .xcodeproj
        WORKSPACE    = 'ios/Mattermost.xcworkspace'
        NEXUS_CREDS  = credentials('nexus-creds')
        JFROG_CREDS  = credentials('jfrog-creds')
        JFROG_URL    = 'http://100.89.50.27:30082/artifactory/example-repo-local'
        NEXUS_URL    = 'http://nexus.utilities.svc.cluster.local:8081/repository/ios-releases'
        SIMULATOR    = 'platform=iOS Simulator,name=iPhone 16,OS=latest'
        REPORTS_DIR  = 'reports'
        // nvm-installed node; source nvm in each shell step
        NVM_DIR      = '/Users/jenkins-agent/.nvm'
        NODE_VERSION = '20'
    }

    stages {
        stage('Checkout') {
            steps {
                git url: 'file:///Users/jenkins-agent/git/mattermost-mobile', branch: 'main'
                script {
                    env.GIT_SHA  = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.IPA_NAME = "${APP_NAME}-${GIT_SHA}-${BUILD_NUMBER}.ipa"
                }
            }
        }

        stage('Validate Environment') {
            steps {
                sh '''
                    export NVM_DIR="$HOME/.nvm"
                    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                    set -e
                    node --version
                    npm --version
                    pod --version
                    xcodebuild -version
                    swiftlint version || true
                    semgrep --version || true
                '''
            }
        }

        stage('JS Dependencies') {
            steps {
                // npm ci uses package-lock.json for reproducible installs
                sh '''
                    export NVM_DIR="$HOME/.nvm"
                    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                    npm ci --prefer-offline
                '''
            }
        }

        stage('iOS Native Dependencies') {
            steps {
                // pod install must run AFTER npm ci (native modules generate podspecs)
                sh '''
                    export NVM_DIR="$HOME/.nvm"
                    [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                    cd ios
                    pod install --repo-update
                '''
            }
        }

        stage('Build IPA') {
            steps {
                sh """
                    mkdir -p build ${REPORTS_DIR}

                    agvtool new-version -all ${BUILD_NUMBER} || true

                    # React Native builds use .xcworkspace, not .xcodeproj
                    xcodebuild archive \\
                        -workspace ${WORKSPACE} \\
                        -scheme '${SCHEME}' \\
                        -configuration Release \\
                        -archivePath build/${APP_NAME}.xcarchive \\
                        CODE_SIGN_IDENTITY=- \\
                        CODE_SIGNING_REQUIRED=NO \\
                        CODE_SIGNING_ALLOWED=NO \\
                        | xcpretty || true

                    xcodebuild -exportArchive \\
                        -archivePath build/${APP_NAME}.xcarchive \\
                        -exportPath build/ \\
                        -exportOptionsPlist ios/ExportOptions-dev.plist \\
                        | xcpretty || true
                """
                archiveArtifacts artifacts: 'build/*.ipa', allowEmptyArchive: true
            }
        }

        stage('Unit Tests') {
            parallel {
                stage('JS Tests') {
                    steps {
                        sh '''
                            export NVM_DIR="$HOME/.nvm"
                            [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                            mkdir -p reports
                            npm test -- --ci --reporters=jest-junit \
                                --outputFile=reports/jest-results.xml || true
                        '''
                        junit allowEmptyResults: true, testResults: 'reports/jest-results.xml'
                    }
                }
                stage('Native Tests') {
                    steps {
                        sh """
                            xcodebuild test \\
                                -workspace ${WORKSPACE} \\
                                -scheme '${SCHEME}' \\
                                -destination '${SIMULATOR}' \\
                                -resultBundlePath build/TestResults.xcresult \\
                                | xcpretty --report junit \\
                                    --output ${REPORTS_DIR}/xcode-test-results.xml || true
                        """
                        junit allowEmptyResults: true, testResults: "${REPORTS_DIR}/xcode-test-results.xml"
                    }
                }
            }
        }

        stage('SAST') {
            parallel {
                stage('ESLint') {
                    steps {
                        sh '''
                            export NVM_DIR="$HOME/.nvm"
                            [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                            mkdir -p reports
                            npx eslint . --ext .js,.jsx,.ts,.tsx \
                                --format json \
                                --output-file reports/eslint.json || true
                        '''
                    }
                }
                stage('SwiftLint') {
                    steps {
                        sh """
                            swiftlint lint --path ios \\
                                --reporter html > ${REPORTS_DIR}/swiftlint.html || true
                            swiftlint lint --path ios \\
                                --reporter json > ${REPORTS_DIR}/swiftlint.json || true
                        """
                    }
                }
                stage('Semgrep') {
                    steps {
                        sh """
                            semgrep --config=auto \\
                                --json \\
                                --output=${REPORTS_DIR}/semgrep-rn.json \\
                                --include='*.ts' --include='*.tsx' --include='*.js' --include='*.swift' \\
                                --exclude='node_modules/' --exclude='build/' . || true
                        """
                    }
                }
            }
            post {
                always {
                    publishHTML([
                        allowMissing: true, alwaysLinkToLastBuild: true, keepAll: true,
                        reportDir: REPORTS_DIR, reportFiles: 'swiftlint.html',
                        reportName: 'SwiftLint'
                    ])
                }
            }
        }

        stage('License Compliance') {
            parallel {
                stage('JS Licenses') {
                    steps {
                        sh '''
                            export NVM_DIR="$HOME/.nvm"
                            [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"
                            mkdir -p reports
                            npx license-checker \
                                --json > reports/js-licenses.json || true
                            # Fail on GPL in JS deps
                            grep -i '"licenses".*GPL' reports/js-licenses.json \
                                && echo "WARNING: GPL license in JS dependencies" || true
                        '''
                    }
                }
                stage('Native Licenses') {
                    steps {
                        sh """
                            licenseplist --output-path ${REPORTS_DIR}/native-licenses || true
                        """
                    }
                }
            }
        }

        stage('Upload Artifacts') {
            steps {
                script {
                    def ipa = sh(script: "find build -name '*.ipa' | head -1", returnStdout: true).trim()
                    if (ipa) {
                        sh """
                            cp '${ipa}' '${IPA_NAME}'

                            curl -sf \\
                                -u "${NEXUS_CREDS_USR}:${NEXUS_CREDS_PSW}" \\
                                --upload-file '${IPA_NAME}' \\
                                '${NEXUS_URL}/${IPA_NAME}' && echo "Nexus: uploaded"

                            curl -sf \\
                                -u "${JFROG_CREDS_USR}:${JFROG_CREDS_PSW}" \\
                                -X PUT \\
                                --upload-file '${IPA_NAME}' \\
                                '${JFROG_URL}/ios/${IPA_NAME}' && echo "JFrog: uploaded"
                        """
                    } else {
                        echo "No IPA found — archive may have failed, skipping upload"
                    }
                }
            }
        }
    }

    post {
        failure {
            sh """
                FAILED_STAGE='${env.FAILED_STAGE ?: "Unknown"}' \\
                BUILD_NUMBER='${BUILD_NUMBER}' \\
                JOB_NAME='${JOB_NAME}' \\
                ERROR_SNIPPET='' LOG_TAIL='' \\
                /opt/llm-analysis.sh || true
            """
            emailext(
                subject: "[iOS-RN FAILURE] ${JOB_NAME} #${BUILD_NUMBER}",
                to: 'hello.dk@outlook.com',
                mimeType: 'text/html',
                body: '${SCRIPT, template="failure-email.groovy"}'
            )
        }
        success {
            emailext(
                subject: "[iOS-RN SUCCESS] ${JOB_NAME} #${BUILD_NUMBER} — IPA ready",
                to: 'hello.dk@outlook.com',
                mimeType: 'text/html',
                body: '${SCRIPT, template="success-email.groovy"}'
            )
        }
        cleanup {
            // Clean node_modules on agent to avoid disk pressure
            sh 'rm -rf node_modules ios/Pods || true'
            deleteDir()
        }
    }
}
